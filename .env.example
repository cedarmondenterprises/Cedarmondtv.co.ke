DEBUG=0
NEWSROOM_2FA_REQUIRED=0
# scripts/configure.py generates both secrets without printing them.
SECRET_KEY=
DOMAIN=cedarmondtv.co.ke
SITE_URL=https://cedarmondtv.co.ke
ALLOWED_HOSTS=cedarmondtv.co.ke,localhost,127.0.0.1
POSTGRES_DB=cedarmond
POSTGRES_USER=cedarmond
POSTGRES_PASSWORD=
NEWSLETTER_ENABLED=0
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Cedarmond TV <news@cedarmondtv.co.ke>

SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Optional webmaster verification tokens (content value only)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=
PINTEREST_SITE_VERIFICATION=

# Optional official channel links (full HTTPS URLs)
WHATSAPP_CHANNEL_URL=
YOUTUBE_CHANNEL_URL=
TELEGRAM_CHANNEL_URL=
FACEBOOK_PAGE_URL=
INSTAGRAM_PROFILE_URL=
TIKTOK_PROFILE_URL=

# Optional integration services. Leave unconfigured features disabled.
MEILISEARCH_URL=
MEILISEARCH_KEY=
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=
UMAMI_DASHBOARD_URL=
GLITCHTIP_DASHBOARD_URL=
UPTIME_KUMA_URL=
LISTMONK_URL=
LISTMONK_USERNAME=
LISTMONK_TOKEN=
WEBPUSH_ENABLED=0
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=
ANYMAIL_WEBHOOK_SECRET=
MAILGUN_API_KEY=
MAILGUN_SENDER_DOMAIN=
MEDIA_S3_ENABLED=0
MEDIA_S3_BUCKET=
MEDIA_S3_ENDPOINT_URL=
MEDIA_S3_REGION=auto
MEDIA_S3_ACCESS_KEY=
MEDIA_S3_SECRET_KEY=
MEDIA_S3_CUSTOM_DOMAIN=

# Move any manually inserted GTM snippet into this setting to prevent duplicates.
GTM_CONTAINER_ID=
